#!/usr/bin/env bash

DEFAULT_YAML_FILE=bluesky-aws-admin/docker-compose-dev.yml

show_help=false
rebuild=false
yaml_file=$DEFAULT_YAML_FILE
shut_down=false
background=false

while [ -n "$1" ]; do # while loop starts
    case "$1" in
    -h) show_help=true && shift ;;
    --help) show_help=true && shift ;;
    --rebuild) rebuild=true && shift ;;
    --yaml-file) yaml_file="$2" && shift && shift ;;
    --shut-down) shut_down=true && shift ;;
    --background) background=true && shift ;;
    *) echo "Option $1 not recognized" && exit 1 ;;
    esac
done

if [ "$show_help" = true ] ; then
    echo ""
    echo "Options:"
    echo "   -h/--help     - show this help message"
    echo "   --rebuild     - rebuild docker images"
    echo "   --yaml-file   - default: $DEFAULT_YAML_FILE"
    echo "   --shut-down   - don't restart"
    echo "   --background  - run in the background with docker's '-d' option"
    echo ""
    echo "Usage:"
    echo "   $0"
    echo "   $0 --yaml-file bluesky-aws-admin/docker-compose-dev.yml --rebuild"
    echo "   $0 --shut-down"
    echo ""
    exit 0
fi

if [ ! -e $yaml_file ]; then
    echo "ERROR:  docker-compose YAML file doesn't exist"
    echo "ERROR:     $yaml_file"
    exit 1
fi

# Newer versions of docker compose are run as `docker compose`; older ones
# as `docker-compose`.  Prefer the former if it's available.
if docker compose version > /dev/null 2>&1; then
    DOCKER_COMPOSE="docker compose"
elif command -v docker-compose > /dev/null 2>&1; then
    DOCKER_COMPOSE="docker-compose"
else
    echo "ERROR:  neither 'docker compose' nor 'docker-compose' is available"
    exit 1
fi

echo "Options"
echo "  Rebuild docker images: $rebuild"
echo "  docker compose command: $DOCKER_COMPOSE"
echo "  docker-compose YAML file: $yaml_file"

if [ "$rebuild" = true ] ; then
    $DOCKER_COMPOSE -p bluesky-aws-admin -f $yaml_file build
fi

# call `down` on all known yaml files, in case previously used yaml file
# is different than this one.
$DOCKER_COMPOSE -p bluesky-aws-admin -f bluesky-aws-admin/docker-compose-dev.yml down --remove-orphans
$DOCKER_COMPOSE -p bluesky-aws-admin -f bluesky-aws-admin/docker-compose-prod.yml down --remove-orphans
$DOCKER_COMPOSE -p bluesky-aws-admin -f $yaml_file down --remove-orphans
if [ "$shut_down" = false ] ; then
    if [ "$background" = false ] ; then
        $DOCKER_COMPOSE -p bluesky-aws-admin -f $yaml_file up
    else
        $DOCKER_COMPOSE -p bluesky-aws-admin -f $yaml_file up -d
    fi
fi
